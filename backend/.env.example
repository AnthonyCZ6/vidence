# Copiar a backend/.env y ajustar. Todas las variables son opcionales.
# NUNCA guardar aquí la frase de acceso de la bóveda.

# Rutas a ffmpeg/ffprobe si no están en el PATH
# VIDENCE_FFMPEG_BIN=C:/ruta/a/ffmpeg.exe
# VIDENCE_FFPROBE_BIN=C:/ruta/a/ffprobe.exe

# Modelo Whisper (subcarpeta de models/whisper/): tiny | small | medium ...
# VIDENCE_WHISPER_MODEL=small
# Idioma fijo (código ISO, p. ej. es). Vacío/ausente = detección automática.
# VIDENCE_WHISPER_LANGUAGE=es
# Hilos de CPU para Whisper (0 = automático)
# VIDENCE_WHISPER_CPU_THREADS=0

# Un fotograma cada N segundos, con un máximo de fotogramas por video
# VIDENCE_FRAME_INTERVAL_SECONDS=5
# VIDENCE_MAX_FRAMES=240

# Tamaño máximo de subida en bytes (4 GiB por defecto)
# VIDENCE_MAX_UPLOAD_BYTES=4294967296

# Servidor (solo loopback en el MVP)
# VIDENCE_HOST=127.0.0.1
# VIDENCE_PORT=8000
